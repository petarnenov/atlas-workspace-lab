FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
ARG TARGETARCH
RUN apk add --no-cache ca-certificates && \
    case "$TARGETARCH" in \
      amd64) digest=4a8128911ccad4e7b481f26635a4cfd1ec064412210526e57ad2c748d356f3b7 ;; \
      arm64) digest=6e9dea7ac4f81562add9e1e31206ba6059d6f5929ad4ed924986223282b3aa9c ;; \
      *) exit 1 ;; \
    esac && \
    wget -q -O /tmp/rc.tar.gz "https://github.com/rustfs/cli/releases/download/v0.1.36/rustfs-cli-linux-${TARGETARCH}-v0.1.36.tar.gz" && \
    echo "$digest  /tmp/rc.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/rc.tar.gz -C /usr/local/bin && rm /tmp/rc.tar.gz && chmod +x /usr/local/bin/rc
ENTRYPOINT ["/bin/sh", "/bootstrap.sh"]
