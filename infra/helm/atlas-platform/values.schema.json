    "environment",
    "syntheticDemo",
    "component",
    "stopped",
    "images",
    "secretRefs",
    "replicas",
    "resources",
    "storageSize"
  ],
  "properties": {
    "environment": {
      "enum": ["dev", "prod"]
    },
    "syntheticDemo": {
      "const": true
    },
    "component": {
      "enum": ["platform"]
    },
    "stopped": {
      "type": "boolean"
    },
