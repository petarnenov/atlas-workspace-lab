      "type": "object",
      "additionalProperties": false,
      "required": [
        "portal-ui",
        "workspace-api",
        "asset-service",
        "processing-worker",
        "postgres",
        "kafka",
        "storage",
        "storage-init"
      ],
      "properties": {
        "portal-ui": {
          "type": "string",
          "pattern": "^atlas/portal-ui:[a-f0-9]{64}$"
        },
        "workspace-api": {
          "type": "string",
          "pattern": "^atlas/workspace-api:[a-f0-9]{64}$"
        },
        "asset-service": {
          "type": "string",
          "pattern": "^atlas/asset-service:[a-f0-9]{64}$"
