      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres-admin",
        "storage-admin",
        "storage-bootstrap",
        "api-identity",
        "asset-runtime",
        "worker-runtime"
      ],
      "properties": {
        "postgres-admin": {
          "const": "postgres-admin"
        },
        "storage-admin": {
          "const": "storage-admin"
        },
        "storage-bootstrap": {
          "const": "storage-bootstrap"
        },
        "api-identity": {
          "const": "api-identity"
        },
        "asset-runtime": {
          "const": "asset-runtime"
        },
        "worker-runtime": {
          "const": "worker-runtime"
        }
