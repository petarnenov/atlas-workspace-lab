        },
        "kafka": {
          "type": "string",
          "pattern": "^atlas/kafka:[a-f0-9]{64}$"
        },
        "storage": {
          "type": "string",
          "pattern": "^atlas/storage:[a-f0-9]{64}$"
        },
        "storage-init": {
          "type": "string",
          "pattern": "^atlas/storage-init:[a-f0-9]{64}$"
        }
      }
    },
