{
  "name": "workspace-api",
  "root": "services/workspace-api",
  "projectType": "application",
  "implicitDependencies": [
    "demo-support"
  ],
  "targets": {
    "build": {
      "command": "./gradlew :workspace-api:assemble --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/build/libs"
      ]
    },
    "test": {
      "command": "./gradlew :workspace-api:test --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ]
    },
    "coverage": {
      "command": "node scripts/local/run.mjs ./gradlew :workspace-api:test :workspace-api:jacocoTestCoverageVerification -Pintegration --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ]
    }
  }
}
