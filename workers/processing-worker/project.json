{
  "name": "processing-worker",
  "root": "workers/processing-worker",
  "projectType": "application",
  "implicitDependencies": [
    "demo-support"
  ],
  "targets": {
    "build": {
      "command": "./gradlew :processing-worker:assemble --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/build/libs"
      ]
    },
    "test": {
      "command": "./gradlew :processing-worker:test --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ]
    },
    "coverage": {
      "command": "node scripts/local/run.mjs ./gradlew :processing-worker:test :processing-worker:jacocoTestCoverageVerification -Pintegration --no-daemon",
      "inputs": [
        "default",
        "javaBuild",
        "^default"
      ]
    }
  }
}
