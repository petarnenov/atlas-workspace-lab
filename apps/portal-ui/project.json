{
  "name": "portal-ui",
  "root": "apps/portal-ui",
  "sourceRoot": "apps/portal-ui/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "pnpm --filter @atlas/portal-ui build",
      "inputs": [
        "default",
        "frontendBuild"
      ]
    },
    "test": {
      "command": "pnpm --filter @atlas/portal-ui test",
      "inputs": [
        "default",
        "frontendBuild"
      ]
    },
    "typecheck": {
      "command": "pnpm --filter @atlas/portal-ui typecheck",
      "inputs": [
        "default",
        "frontendBuild"
      ]
    }
  }
}
