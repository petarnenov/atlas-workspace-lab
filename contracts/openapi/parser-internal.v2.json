{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas neutral document parser API",
    "version": "2.0.0",
    "description": "LAB-108 approved revision 1. Combined UTF-8 response bound 10 MiB; validated PDF input only."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "parserHealthlive",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "parserHealthready",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/internal/v2/parse": {
      "post": {
        "operationId": "parseValidatedDocumentV2",
        "security": [
          {
            "parserToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 5242880
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded provider-neutral conversion; native output is optional",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResult"
                }
              }
            }
          },
          "400": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Conversion rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "parserToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated ephemeral parser token, never a user token"
      }
    },
    "schemas": {
      "ParseResult": {
        "type": "object",
        "properties": {
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "document": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "1"
              },
              "markdown": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10485760
              }
            },
            "required": [
              "schemaVersion",
              "markdown"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "converter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "pipeline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "converter",
              "pipeline"
            ],
            "additionalProperties": false
          },
          "native": {
            "type": "object",
            "properties": {
              "mediaType": {
                "type": "string",
                "const": "application/json"
              },
              "content": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "mediaType",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "sourceSha256",
          "pageCount",
          "document",
          "provenance"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "correlationId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
