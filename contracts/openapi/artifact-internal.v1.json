{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas asset-owned derived artifact API",
    "version": "1.0.0",
    "description": "LAB-108 approved revision 1. STAGED objects are hidden until a matching fenced processed-v2 outcome is committed. Combined body limit 10 MiB UTF-8 bytes."
  },
  "paths": {
    "/internal/v1/assets/{assetId}/parsed-stages": {
      "post": {
        "operationId": "stageParsedDocument",
        "security": [
          {
            "artifactWriter": []
          }
        ],
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "inputEventId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "correlationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sourceSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "attemptFence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "pageCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "document": {
                    "type": "object",
                    "properties": {
                      "schemaVersion": {
                        "type": "string",
                        "const": "1"
                      },
                      "markdown": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10485760
                      }
                    },
                    "required": [
                      "schemaVersion",
                      "markdown"
                    ],
                    "additionalProperties": false
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "converter": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "pipeline": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "converter",
                      "pipeline"
                    ],
                    "additionalProperties": false
                  },
                  "native": {
                    "type": "object",
                    "properties": {
                      "mediaType": {
                        "type": "string",
                        "const": "application/json"
                      },
                      "content": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "mediaType",
                      "content"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "inputEventId",
                  "correlationId",
                  "sourceSha256",
                  "attemptFence",
                  "pageCount",
                  "document",
                  "provenance"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed authorized document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "artifactId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "201": {
            "description": "Immutable stage created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "artifactId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid workload identity"
          },
          "403": {
            "description": "Denied scope"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "409": {
            "description": "Conflicting idempotency key"
          },
          "413": {
            "description": "Payload exceeds byte limit"
          },
          "422": {
            "description": "Invalid document binding"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/internal/v2/assets/{assetId}/parsed": {
      "get": {
        "operationId": "readParsedDocumentV2",
        "security": [
          {
            "artifactReader": []
          }
        ],
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "markdown",
                "json"
              ],
              "default": "markdown"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed tenant-scoped artifact",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "type": "string",
                      "const": "1"
                    },
                    "markdown": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10485760
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "markdown"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Access denied or unavailable artifact"
          },
          "401": {
            "description": "Access denied or unavailable artifact"
          },
          "403": {
            "description": "Access denied or unavailable artifact"
          },
          "404": {
            "description": "Access denied or unavailable artifact"
          },
          "503": {
            "description": "Unavailable or corrupt content"
          }
        }
      }
    },
    "/internal/v1/assets/{assetId}/parsed": {
      "get": {
        "operationId": "readLegacyParsedDocument",
        "security": [
          {
            "artifactReader": []
          }
        ],
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "markdown",
                "json"
              ],
              "default": "markdown"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed tenant-scoped artifact",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Access denied or unavailable artifact"
          },
          "401": {
            "description": "Access denied or unavailable artifact"
          },
          "403": {
            "description": "Access denied or unavailable artifact"
          },
          "404": {
            "description": "Access denied or unavailable artifact"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "artifactWriter": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256 worker workload; audience asset-artifact-write; verified tenant and subject"
      },
      "artifactReader": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256 BFF workload; audience asset-artifact-read; verified tenant and subject"
      }
    }
  }
}
